{
  "name": "ai-desk-companion",
  "productName": "事务助手",
  "version": "0.1.0",
  "description": "以 AI 通知分析为入口,集成桌宠、工作台、日历与待办的个人事务管理工具",
  "main": "out/main/index.js",
  "author": "MoMingYu",
  "private": true,
  "build": {
    "appId": "com.momingyu.aidesk",
    "productName": "事务助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "node_modules/pdfjs-dist/cmaps",
        "to": "cmaps"
      },
      {
        "from": "node_modules/pdfjs-dist/standard_fonts",
        "to": "standard_fonts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "事务助手",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "gen:assets": "node scripts/gen-assets.mjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "html-to-text": "^10.0.1",
    "imapflow": "^2.0.4",
    "mailparser": "^3.9.27",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^4.10.38",
    "sanitize-html": "^2.17.7",
    "solarlunar": "^3.1.0",
    "sql.js": "^1.13.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
